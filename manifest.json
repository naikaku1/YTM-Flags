{
  "manifest_version": 3,
  "name": "YTM Flags",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "description": "YouTube Music の試験スイッチ(実験フラグ)を切り替えて、新しいデザインを試したり元に戻したりする非公式の拡張",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "YTM Flags", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
